{
    "name": "@ever-works/trigger-tasks",
    "version": "0.1.0",
    "description": "Ever Works Trigger Tasks - Background jobs and Trigger.dev integration for the Ever Works platform",
    "author": {
        "name": "Ever Co. LTD",
        "email": "ever@ever.co",
        "url": "https://ever.co"
    },
    "license": "AGPL-3.0",
    "private": true,
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "type-check": "tsc -p tsconfig.json --noEmit",
        "dev": "tsc -p tsconfig.json --watch",
        "build:plugins": "pnpm --filter './packages/plugins/*' build",
        "prepare:plugins": "node scripts/prepare-plugins.js",
        "dev:trigger": "trigger dev",
        "predeploy:trigger": "pnpm prepare:plugins",
        "deploy:trigger": "trigger deploy",
        "app-runtime:local-worker": "node dist/tasks/trigger/app-runtime-local-worker.js",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ever-works/agent": "workspace:*",
        "@ever-works/contracts": "workspace:*",
        "@ever-works/job-runtime-trigger-plugin": "workspace:*",
        "@ever-works/plugin": "workspace:*",
        "@ever-works/pty-local-plugin": "workspace:*",
        "@nestjs/cache-manager": "^3.1.3",
        "@nestjs/common": "^11.2.7",
        "@nestjs/core": "^11.2.7",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/microservices": "^11.2.7",
        "@nestjs/platform-express": "^11.2.7",
        "@nestjs/websockets": "^11.2.7",
        "@trigger.dev/sdk": "4.5.11",
        "class-transformer": "^0.5.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "superjson": "^1.13.3",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@trigger.dev/build": "4.5.11",
        "@types/node": "^26.6.4",
        "@types/ws": "^8.18.0",
        "trigger.dev": "4.5.11",
        "typescript": "^5.9.3",
        "vitest": "^5.0.3"
    }
}
