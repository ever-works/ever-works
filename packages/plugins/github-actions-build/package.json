{
	"name": "@ever-works/github-actions-build-plugin",
	"version": "1.0.0",
	"description": "GitHub Actions build plugin for Ever Works - turns a commit into an image through a workflow Ever Works writes into the repository (APW-05 plan §4.3)",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"license": "AGPL-3.0",
	"private": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --noEmit && tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit && tsc -p tsconfig.specs.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@ever-works/contracts": "workspace:*",
		"fflate": "^0.4.8",
		"libsodium-wrappers": "^0.7.15",
		"octokit": "^4.0.0"
	},
	"peerDependencies": {
		"@ever-works/plugin": "workspace:*"
	},
	"devDependencies": {
		"@ever-works/plugin": "workspace:*",
		"@types/libsodium-wrappers": "^0.7.14",
		"@types/node": "^22.0.0",
		"ajv": "^8.18.0",
		"js-yaml": "^5.2.3",
		"tsup": "^8.4.0",
		"typescript": "^5.7.3",
		"vitest": "^4.1.0"
	},
	"everworks": {
		"plugin": {
			"id": "github-actions-build",
			"name": "GitHub Actions builds",
			"version": "1.0.0",
			"category": "build",
			"capabilities": [
				"build"
			],
			"description": "Builds the App Work's container image on GitHub-hosted runners, through the workflow Ever Works writes into the repository's tracked branch",
			"author": {
				"name": "Ever Works Team"
			},
			"license": "AGPL-3.0",
			"autoEnable": true,
			"builtIn": true,
			"visibility": "user-only"
		}
	},
	"publishConfig": {
		"access": "restricted",
		"registry": "https://registry.npmjs.org"
	}
}
