{
	"name": "@ever-works/k8s-apps-tier-plugin",
	"version": "1.0.0",
	"description": "Ever Works Apps (managed) — runs App Works on the platform's own Kubernetes cluster (APW-10 lite)",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"license": "AGPL-3.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsc --noEmit && tsup",
		"dev": "tsup --watch",
		"type-check": "tsc --noEmit && tsc -p tsconfig.specs.json --noEmit",
		"clean": "rm -rf dist",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ever-works/k8s-plugin": "workspace:*",
		"@kubernetes/client-node": "^1.4.0",
		"js-yaml": "^5.5.0"
	},
	"peerDependencies": {
		"@ever-works/plugin": "workspace:*"
	},
	"devDependencies": {
		"@ever-works/plugin": "workspace:*",
		"@types/node": "26.6.4",
		"tsup": "^8.4.0",
		"typescript": "^5.7.3",
		"vitest": "^5.0.5"
	},
	"everworks": {
		"plugin": {
			"id": "k8s-apps-tier",
			"name": "Ever Works Apps (managed)",
			"version": "1.0.0",
			"category": "deployment",
			"capabilities": [
				"deployment",
				"apps-tier",
				"app-dependency"
			],
			"description": "Runs App Works on the platform's own Kubernetes cluster, one restricted namespace per App Work",
			"author": {
				"name": "Ever Works Team"
			},
			"license": "AGPL-3.0",
			"autoEnable": true,
			"systemPlugin": true,
			"builtIn": true,
			"visibility": "hidden"
		}
	}
}
