{
	"name": "@ever-works/oidc-identity",
	"version": "1.0.0",
	"description": "OpenID Connect identity provider plugin (Ever ID) for Ever Works",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"license": "AGPL-3.0",
	"private": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./testing": {
			"types": "./dist/testing/fake-oidc-provider.d.ts",
			"import": "./dist/testing/fake-oidc-provider.js",
			"require": "./dist/testing/fake-oidc-provider.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --noEmit && tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"@ever-works/plugin": "workspace:*"
	},
	"dependencies": {
		"jose": "^6",
		"openid-client": "^6"
	},
	"devDependencies": {
		"@ever-works/plugin": "workspace:*",
		"@types/node": "^22.0.0",
		"ajv": "^8.18.0",
		"ajv-formats": "^3.0.1",
		"tsup": "^8.0.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	},
	"everworks": {
		"plugin": {
			"id": "oidc-identity",
			"name": "OpenID Connect identity (Ever ID)",
			"version": "1.0.0",
			"category": "identity",
			"capabilities": [
				"identity-provider"
			],
			"description": "OpenID Connect relying party for Ever ID: browser sign-in, connected identities, delegated reads and back-channel logout",
			"author": {
				"name": "Ever Works Team"
			},
			"license": "AGPL-3.0",
			"builtIn": true,
			"autoEnable": false
		}
	},
	"publishConfig": {
		"access": "restricted",
		"registry": "https://registry.npmjs.org"
	}
}
