{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2021",
		// Type-check against the ES2022 library the Node 26 runtime provides (the same set
		// `"target": "ES2022"` would default to). Up to @types/node 22 a compatibility shim
		// declared `Array#at` & co. for ES2021-lib projects; @types/node 26 drops it. The
		// emitted syntax (`target`) is unchanged.
		"lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker.ImportScripts", "ScriptHost"],
		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
