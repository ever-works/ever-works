{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        // Required by `subscriptions/billing/stripe-catalog.ts`, which imports the pricing catalog
        // as data. The catalog is JSON rather than TypeScript so that
        // `scripts/stripe-sync-catalog.mjs` — plain node, no build step — reads the exact same
        // bytes the running app does; a second hand-maintained copy would drift, and the thing it
        // would drift on is prices.
        "resolveJsonModule": true,
        "target": "ES2021",
        // Type-check against the ES2022 library the Node 26 runtime provides (the same set
        // `"target": "ES2022"` would default to). Up to @types/node 22 a compatibility shim
        // declared `Array#at` & co. for ES2021-lib projects; @types/node 26 drops it. The
        // emitted syntax (`target`) is unchanged.
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable",
            "DOM.AsyncIterable",
            "WebWorker.ImportScripts",
            "ScriptHost"
        ],
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true,
        "skipLibCheck": true,
        "strictNullChecks": false,
        "noImplicitAny": false,
        "strictBindCallApply": false,
        "forceConsistentCasingInFileNames": false,
        "noFallthroughCasesInSwitch": false,
        "paths": {
            "@src/*": ["./src/*"]
        }
    },
    "exclude": ["examples/**/*", "dist/**/*", "**/*.d.ts"]
}
