{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "builder": "swc",
        "deleteOutDir": false,
        "typeCheck": true,
        "assets": [
            {
                "include": "**/*.json",
                "outDir": "dist"
            }
        ]
    }
}
