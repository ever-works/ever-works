{
	"name": "ever-works",
	"version": "0.1.0",
	"description": "Ever Works - Open Work Builder Platform",
	"homepage": "https://ever.works",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-works/ever-works.git"
	},
	"bugs": {
		"url": "https://github.com/ever-works/ever-works/issues"
	},
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"private": true,
	"scripts": {
		"dev:apps": "turbo run dev --filter=./apps/* --filter=!./apps/docs --filter=!./apps/desktop --filter=!./apps/desktop-node --filter=!./apps/node",
		"dev:api": "turbo run dev --filter=ever-works-api",
		"dev:web": "turbo run dev --filter=ever-works-web",
		"dev:docs": "turbo run dev --filter=ever-works-docs",
		"dev:trigger": "turbo run dev:trigger --filter=@ever-works/trigger-tasks",
		"deploy:trigger": "turbo run deploy:trigger --filter=@ever-works/trigger-tasks",
		"build": "turbo run build --filter=!./apps/docs --filter=!./apps/desktop --filter=!./apps/desktop-node --filter=!./apps/node",
		"build:all": "turbo run build",
		"build:apps": "turbo run build --filter=./apps/* --filter=!./apps/docs --filter=!./apps/desktop --filter=!./apps/desktop-node --filter=!./apps/node",
		"build:desktop": "turbo run build --filter=ever-works-desktop",
		"build:node": "turbo run build --filter=ever-works-node",
		"build:desktop-node": "turbo run build --filter=ever-works-desktop-node",
		"build:packages": "turbo run build --filter=./packages/*",
		"build:plugins": "turbo run build --filter=./packages/plugin --filter=./packages/plugins/*",
		"build:api": "turbo run build --filter=ever-works-api",
		"build:web": "turbo run build --filter=ever-works-web",
		"build:docs": "turbo run build --filter=ever-works-docs",
		"prepare:husky": "husky install .husky",
		"prepare": "husky",
		"lint": "turbo run lint",
		"test": "turbo run test --continue",
		"type-check": "turbo run type-check",
		"clean": "turbo run clean",
		"format": "prettier --write \"**/*.{ts,tsx,jsx,json,css,md}\" --log-level warn",
		"test:e2e": "turbo run test:e2e --filter=ever-works-web",
		"format:check": "prettier --check \"**/*.{ts,tsx,jsx,json,css,md}\"",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish",
		"publish:plugins:dry": "node scripts/release-npm-packages.mjs --dry-run",
		"publish:plugins": "node scripts/release-npm-packages.mjs"
	},
	"keywords": [],
	"devDependencies": {
		"@changesets/cli": "^2.27.10",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
