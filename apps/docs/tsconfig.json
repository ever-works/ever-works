{
	// This file is not used in compilation. It is here just for a nice editor experience.
	"extends": "@docusaurus/tsconfig",
	"compilerOptions": {
		"baseUrl": ".",
		"types": ["@docusaurus/module-type-aliases"],
		// Force @types/react / @types/react-dom resolution to the copy pinned in this
		// app's devDependencies, so every consumer in this app sees one ReactNode.
		// When the app ran React 18 with @types/react 18, several Docusaurus 3 packages
		// (e.g. @docusaurus/module-type-aliases, @docusaurus/react-loadable,
		// @docusaurus/theme-common) transitively pulled @types/react@19, which leaked
		// the React-19 ReactNode (includes `bigint`) into types for `Link` etc. and
		// produced TS2786 "'Link' cannot be used as a JSX component" (Footer/FooterLinks,
		// Navbar/DesktopMenu). The app is on React 19 and @types/react 19 now; the pin
		// still keeps a second @types/react copy from creeping in.
		"paths": {
			"@site/*": ["./*"],
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"]
		}
	},
	// Generated output, never source. `build/assets/files/` in particular holds
	// code samples Docusaurus COPIES out of other packages so readers can
	// download them — they import `typeorm`, `next-intl`, `@/components/...`
	// and other things that do not resolve from this app and never should.
	// Without this, `type-check` passes on a fresh clone and fails the moment
	// anyone builds the docs locally, which makes the task non-deterministic.
	"exclude": ["build", ".docusaurus", "node_modules"]
}
