# App type
APP_TYPE=api

# API Port
PORT=3100

# Debugging
HTTP_DEBUG=false

# WEB App URL
WEB_URL=http://localhost:3000

# App auth secret
AUTH_SECRET=secret_key_here

# 32-byte hex key for per-Work PLATFORM_SYNC_SECRET / WEBHOOK_SECRET encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ENCRYPTION_KEY=

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Dev-mode platform-admin bootstrap (comma-separated emails). When a
# user registers (POST /api/auth/register) whose email matches an entry
# here (case-insensitive), they receive isPlatformAdmin=true at create
# time. Each entry is either an EXACT email or a PREFIX-glob ending in
# `*` (e.g. `e2e-seed-primary-*@test.local`). Only a single trailing
# `*` is honoured — no regex / mid-string wildcards. Leave UNSET in
# production — used only by local dev / e2e suites that need an admin
# storage-state against a fresh DB. See AuthService
# `grantPlatformAdminIfBootstrapped`.
# EVER_WORKS_BOOTSTRAP_PLATFORM_ADMIN_EMAILS=e2e-seed-primary-*@test.local

# =============================================================================
# AUTH RUNTIME CONFIGURATION
# =============================================================================

AUTH_URL=http://localhost:3100/api/internal/auth-runtime

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# GitHub Auth
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_CALLBACK_URL="${WEB_URL}/api/oauth/github/callback"

###############
# Google Auth
###############

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="${WEB_URL}/api/oauth/google/callback"

# Facebook Auth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL="${WEB_URL}/api/oauth/facebook/callback"

# LinkedIn Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL="${WEB_URL}/api/oauth/linkedin/callback"

# Jitsu Analytics
JITSU_HOST=
JITSU_WRITE_KEY=

# =============================================================================
# Trigger.dev configuration
# =============================================================================
TRIGGER_ENABLED=false
TRIGGER_SECRET_KEY=
TRIGGER_API_URL="https://api.trigger.dev"
TRIGGER_INTERNAL_SECRET=
# micro | small-1x | small-2x | medium-1x | medium-2x | large-1x | large-2x
TRIGGER_MACHINE=
# To be defined on Trigger.dev Worker or Trigger.dev Cloud.
TRIGGER_INTERNAL_API_URL=http://localhost:3100/internal/trigger

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database type: sqlite | postgres | mysql
DATABASE_TYPE=sqlite

# =============================================================================
# SQLITE CONFIGURATION (when DATABASE_TYPE=sqlite)
# =============================================================================

# SQLite database path (optional - uses defaults if not set)
# API apps default: :memory: (development) or /tmp/ever-works-api.db (production)
# DATABASE_PATH=/path/to/your/database.db

# Force in-memory database (true/false) - overrides default behavior
# Keep this disabled when auth runtime is enabled because sessions require persistent storage.
DATABASE_IN_MEMORY=false

# =============================================================================
# POSTGRESQL CONFIGURATION (when DATABASE_TYPE=postgres)
# =============================================================================

# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_password
# DATABASE_NAME=ever_works
# DATABASE_URL=

# =============================================================================
# MYSQL/MARIADB CONFIGURATION (when DATABASE_TYPE=mysql)
# =============================================================================

# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USERNAME=root
# DATABASE_PASSWORD=your_password
# DATABASE_NAME=ever_works
# DATABASE_URL=

# =============================================================================
# COMMON DATABASE OPTIONS
# =============================================================================

# Enable SQL query logging (true/false)
DATABASE_LOGGING=false

# Enable SSL/TLS for database connections (true/false)
DATABASE_SSL_MODE=false
DATABASE_CA_CERT=

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# MAILER PROVIDER: smtp|none|resend
MAILER_PROVIDER=none

# Email from
EMAIL_FROM='Ever Works <ever@ever.works>'

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
SMTP_SECURE=false
SMTP_IGNORE_TLS=false

# RESEND
RESEND_APIKEY=
RESEND_EMAIL_FROM=

# =============================================================================
# TWENTY CONFIGURATION
# =============================================================================

TWENTY_CRM_BASE_URL=https://api.twenty.com
TWENTY_CRM_API_KEY=
TWENTY_CRM_WORKSPACE_ID=

# Per-tenant Twenty workspace credentials (cross-tenant isolation).
# REQUIRED to use the tenant-scoped CRM endpoints (companies/people): each tenant
# must have its OWN Twenty workspace + API key here so a caller can only ever
# touch their own workspace. JSON map of tenantId -> { apiKey, workspaceId,
# apiUrl? }. A tenant with no entry (or an entry without an apiKey) FAILS CLOSED
# — the request is refused (404); we never fall back to the shared key for
# tenant-scoped calls. The shared values above are used only by internal/system
# sync paths (which are not per-caller).
# Example: {"<tenant-uuid>":{"apiKey":"...","workspaceId":"..."}}
TWENTY_CRM_TENANTS=

TWENTY_CRM_MAX_RETRIES=3
TWENTY_CRM_RETRY_DELAY_MS=1000
TWENTY_CRM_BACKOFF_MULTIPLIER=2
TWENTY_CRM_TIMEOUT_MS=30000
TWENTY_CRM_ENABLE_LOGGING=true
TWENTY_CRM_WORKSPACE_ID=

# =============================================================================
# DIRECTORY GENERATION
# =============================================================================

# Stale generation timeout in hours (default: 2 hours)
DIRECTORY_STALE_TIMEOUT_HOURS=2

# =============================================================================
# SCHEDULED DIRECTORY UPDATES
# =============================================================================

SCHEDULED_UPDATES_ENABLED=true
SCHEDULED_UPDATES_DISPATCH_INTERVAL_MINUTES=5
SCHEDULED_UPDATES_MAX_BATCH=25
SCHEDULED_UPDATES_MAX_FAILURE_BEFORE_PAUSE=3
PAY_PER_USE_PRICE_USD=5

# =============================================================================
# SUBSCRIPTIONS & BILLING
# =============================================================================

SUBSCRIPTIONS_ENABLED=false
BILLING_DEFAULT_CURRENCY=usd
SUBSCRIPTIONS_DEFAULT_PLAN=free

# Payment provider (the money path — checkout, webhook, invoices,
# auto-recharge). Both are SECRETS: never log them, never return them
# from an API response.
#
# Leave BOTH blank to keep the platform on the manual billing provider:
# every money-moving method then fails closed with a mapped 4xx/503 and
# the Billing page renders its coming-soon cards.
#
#   STRIPE_SECRET_KEY     — enables checkout + off-session charges.
#   STRIPE_WEBHOOK_SECRET — enables POST /api/billing/webhook. Without it
#                           the receiver rejects EVERY delivery with 401
#                           (fail-closed, same posture as the Slack and
#                           GitHub receivers).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Credits (billing spec docs/specs/features/billing/spec.md).
#
#   CREDITS_ENFORCEMENT      — on|off. UNSET resolves to ON when
#                              STRIPE_SECRET_KEY is present (money is
#                              real) and OFF otherwise (self-hosted, dev).
#   CREDITS_MARGIN_PERCENT   — platform margin over metered provider list
#                              cost. UNSET uses the catalog's value (35).
#   CREDITS_DAILY_FREE       — universal daily allowance (default 50).
#   PAYG_MAX_MONTHLY_CAP_CREDITS — ceiling for a self-service
#                              pay-as-you-go cap (default: catalog, 100000).
#CREDITS_ENFORCEMENT=
#CREDITS_MARGIN_PERCENT=
#CREDITS_DAILY_FREE=50
#PAYG_MAX_MONTHLY_CAP_CREDITS=100000

# =============================================================================
# WEBSITE TEMPLATE AUTO-UPDATE
# =============================================================================

# Enable automatic website template updates (true/false)
WEBSITE_TEMPLATE_AUTO_UPDATE_ENABLED=true

# Beta branch name for beta template updates
WEBSITE_TEMPLATE_BETA_BRANCH=stage


# ============================================
# Sentry (error tracking, traces, profiling)
# ============================================
# Get the DSN from https://sentry.io -> Ever Works project -> Settings ->
# Client Keys. Without DSN set, Sentry SDK is a no-op (graceful).
SENTRY_DSN=
# 'development' / 'staging' / 'production'. Deployed envs override
# via the k8s manifest; local dev defaults to 'development'.
SENTRY_ENVIRONMENT=development
# Override the auto-picked sample rate (default 0.1 in prod, 1.0 elsewhere).
# SENTRY_TRACES_SAMPLE_RATE=1.0
# INBOUND intake — the Client Secret of the Sentry internal integration whose
# webhook URL points at POST /api/ingest/sentry/events (Sentry -> Settings ->
# Developer Settings -> <integration> -> Client Secret). Sentry signs every
# delivery with it (Sentry-Hook-Signature); unset = the receiver answers 401
# and files nothing. Each Sentry installation must then be claimed by its
# owner via POST /api/ingest/sentry/bindings before its alerts become Tasks.
SENTRY_WEBHOOK_CLIENT_SECRET=

# ============================================
# PostHog (server-side analytics + feature flags + logs)
# ============================================
# Project (public) API key — same phc_* as the marketing site uses;
# not a security secret. Without it set, PostHog SDK is a no-op (graceful).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Event-volume controls -------------------------------------------------
# PostHog bills per event against a 1M/month allowance. On 2026-08-31 this API
# was emitting ~110k events/day of pure machine traffic (synthetic probes,
# internal calls, duplicated events) against 0-13 real product events/day.
# These three knobs exist so that can never silently recur.
#
# Master kill switch for ALL capture (events, $log, identify). The client is
# still constructed, so feature flags keep working. Default: true.
# Set this to false in dev/stage while they share prod's PostHog project.
# POSTHOG_CAPTURE_ENABLED=true
#
# Which log levels are forwarded to PostHog Logs as `$log` events. Accepts a
# comma-separated list, `all`, or `none`. The console still receives EVERY
# level regardless, so `kubectl logs` is unaffected. Default: warn,error.
# POSTHOG_LOG_LEVELS=warn,error
#
# Re-enable the per-endpoint `api_<method>_<path>` companion event. It fired
# alongside every `api_request` and duplicated it 1:1 (129,426 vs 129,205 over
# 3 days), so it is now off; `api_request` already carries `endpoint` as a
# property. Default: false.
# POSTHOG_TRACK_PER_ENDPOINT_EVENTS=false
#
# Extra path prefixes excluded from analytics, comma-separated. Additive to
# the built-in list (/api/health, /api/version, /api/info, /internal,
# /.well-known, /metrics). Matches on exact hit or prefix followed by `/`.
# POSTHOG_ANALYTICS_EXCLUDE_PATHS=


# ============================== PLUGINS ========================================

# GitHub Plugin (separate from GitHub Auth above)
PLUGIN_GITHUB_CLIENT_ID=
PLUGIN_GITHUB_CLIENT_SECRET=
# Redirect URL or callback: [WEB_DOMAIN]/api/oauth/github/callback/plugins
#
# Trusted review bots (self-build fleet, R16). Reviews, inline findings and
# summary comments from these GitHub logins become Task rejection feedback
# (with severity) for the next resumed run. Comma separated, case-insensitive.
# Default: coderabbitai[bot],copilot-pull-request-reviewer[bot],copilot,chatgpt-codex-connector[bot],greptile-apps[bot]
# `none` disables every bot. The platform's own `<GITHUB_APP_SLUG>[bot]`
# identity is ALWAYS excluded, even if listed here. `github-actions[bot]` is
# deliberately not a default: any workflow in a repository can post as it.
# GITHUB_TRUSTED_REVIEW_BOTS=

# Tavily Plugin
PLUGIN_TAVILY_API_KEY=

# ScreenshotOne Plugin
PLUGIN_SCREENSHOTONE_ACCESS_KEY=
PLUGIN_SCREENSHOTONE_SECRET_KEY=


# OpenRouter Plugin
PLUGIN_OPENROUTER_API_KEY=
PLUGIN_OPENROUTER_DEFAULT_MODEL='openai/gpt-5-nano'
PLUGIN_OPENROUTER_SIMPLE_MODEL='openai/gpt-5-nano'
PLUGIN_OPENROUTER_MEDIUM_MODEL='moonshotai/kimi-k2.5'
PLUGIN_OPENROUTER_COMPLEX_MODEL='moonshotai/kimi-k2.5'


# ─── Onboarding Wizard v2 — Ever Works default providers ────────────────────
# Each platform-default is env-gated until its external resource is provisioned.

# "Ever Works Git" storage — push customer repos to a platform-owned GitHub org
STORAGE_EVER_WORKS_GIT_ENABLED=false
EVER_WORKS_CUSTOMERS_GITHUB_ORG=ever-works-cloud
EVER_WORKS_CUSTOMERS_GITHUB_PAT=
EVER_WORKS_CUSTOMERS_GITHUB_VISIBILITY=private

# "Ever Works" deploy — platform-owned Kubernetes tenant cluster
DEPLOY_EVER_WORKS_ENABLED=false
EVER_WORKS_DEPLOY_KUBECONFIG=
EVER_WORKS_DEPLOY_KUBECONFIG_PATH=
EVER_WORKS_DEPLOY_NAMESPACE=ever-works-tenants
EVER_WORKS_DEPLOY_INGRESS_HOST_TEMPLATE={slug}.ever.works
EVER_WORKS_DEPLOY_INGRESS_CLASS=nginx
EVER_WORKS_DEPLOY_TLS_ISSUER=letsencrypt-prod
EVER_WORKS_DEPLOY_REGISTRY=
EVER_WORKS_DEPLOY_MAX_WORKS_PER_USER=3

# EW-734 — collision-safe managed `*.ever.works` subdomain for the k8s
# deploy path. Default OFF so the 7 already-deployed k8s Works keep
# deriving their Ingress host from `work.website` (legacy behaviour).
# Flip to `true` after running the one-off backfill CLI (`cli backfill
# managed-subdomain --write`) so existing Works own their persisted
# claim before the allocator starts looking it up.
K8S_MANAGED_SUBDOMAIN=false

# ─── User Research Agent (EW-584) ───────────────────────────────────────────
# Tool-calling AI agent that researches new users at signup and generates
# personalized Work proposals.

# Kill switch for the signup listener (default on).
USER_RESEARCH_ENABLED=true

# Daily @Cron rerun for users with stale profiles (default off — opt in per env).
USER_RESEARCH_SCHEDULED_RERUN_ENABLED=false

# User-facing research controls. Timeout is milliseconds; runs are per user per day.
USER_RESEARCH_TIMEOUT_MS=1800000
USER_RESEARCH_MAX_RUNS_PER_DAY=3

# =============================================================================
# SECURITY (2026-05-17 audit) — see docs/specs/security/THREAT-MODEL.md
# =============================================================================

# C-08: 32-byte hex key for at-rest AES-256-GCM encryption of plugin secret
# settings (envelope-prefixed `enc::v1::...`). REQUIRED in production —
# the app refuses to start if encrypted secrets exist without this key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLUGIN_SECRET_ENCRYPTION_KEY=

# C-04: comma-separated allow-list of hosts permitted in user-supplied
# `emailVerificationCallbackUrl` / `passwordResetCallbackUrl`. WEB_URL's host
# is always included by default. Add CLI / admin / docs hosts as needed.
# Example: ALLOWED_CALLBACK_HOSTS=app.example.com,cli.example.com
ALLOWED_CALLBACK_HOSTS=

# H-17: per-user login lockout. Defaults: 5 failed verifies → 15 min lock.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MS=900000

# M-19: HTTP body parser size limit (Express bytes-style suffix or number).
# Default 1mb. Increase only for endpoints that legitimately accept larger
# uploads — most don't.
BODY_LIMIT=1mb

# C-11: comma-separated GitHub org logins whose verified members are allowed
# to trigger community-PR auto-apply. Default empty = community-PR auto-apply
# disabled entirely. Add only orgs you trust to vet contributors.
# Example: COMMUNITY_PR_VERIFIED_ORGS=ever-works,ever-co
COMMUNITY_PR_VERIFIED_ORGS=

# H-24: audit-log every agent-pipeline bash invocation to structured logs
# (CloudWatch / Loki / Sentry breadcrumbs). 'true' to enable. Recommended
# in production for forensic visibility into prompt-injected agent actions.
AGENT_BASH_AUDIT_LOG=false

# -----------------------------------------------------------------------------
# TASK-GRAPH FAN-OUT (self-build slice AH) — starts TODO Tasks whose blockers
# have cleared, on the same per-minute tick as the recurring / scheduled scans.
# -----------------------------------------------------------------------------
# This is the ONE driver that begins work nobody clicked, so it ships OFF.
#
# !! READ THE ZERO THE OTHER WAY ROUND !!
# For AGENT_MAX_CONCURRENT_RUNS_PER_WORK / _PER_ORG above, 0 means "no ceiling".
# HERE, 0 means "no starts" — the driver does nothing. Set a POSITIVE number to
# switch it on; it is the maximum number of Tasks the fan-out may start for ONE
# owner in one tick.
#
# Every start still goes through the ordinary dispatch path: global stop flag,
# per-Work and per-org concurrency valves, plan entitlement, credits precheck
# and the agent's own budget. A Task any of them refuses stays in `todo` and is
# a candidate again next tick — this can raise throughput, never a ceiling.
TASK_FANOUT_MAX_STARTS_PER_OWNER=0

# How many TODO Tasks one fan-out tick SCANS before blocker / agent / admission
# filtering. Bounds the tick's cost (the blocker check is one query per blocker
# row), not how much work starts. Default 50; a non-positive or unparseable
# value falls back to 50.
TASK_FANOUT_SCAN_LIMIT=50

# =============================================================================
# FLEET (self-hosted runner nodes)
# =============================================================================
# The node-facing API surface: enroll, heartbeat, and the job lease protocol
# (/api/fleet/**). Every setting here already existed and had no documented
# home; none of them is new. Defaults are what runs today, so an empty block
# is the current behaviour.
#
# Wire-contract warning. `/api/fleet/enroll`, `/api/fleet/heartbeat` and
# `/api/fleet/jobs/*` are spoken by software installed on other people's
# machines. Changing a DTO on those routes breaks every node that has not been
# upgraded yet — the global ValidationPipe runs `forbidNonWhitelisted`, so an
# unexpected field is a 400, not a silent drop. The node-contract conformance
# suite gates that (apps/api/src/fleet/__tests__/node-contract.*), and
# docs/runbooks/FLEET_BREAK_GLASS.md is how you recover if one gets through.

# Master switch for the WHOLE fleet surface. Anything other than 'false'
# leaves it on (it defaults ON, because Fleet already ships). When off, every
# /api/fleet/** route answers 404 rather than 403 — a disabled deployment does
# not confirm the surface exists. Note the node has no 404 branch: it reports
# that as a generic "invalid request", indistinguishable from a typo in its
# API URL. Turning this off is not a way to pause a fleet; see the panic
# controls in docs/features/fleet.md.
FLEET_ENABLED=true

# ROUTING SELECTOR, NOT A PANIC CONTROL. 'false' takes the node runtime out of
# service, and the work it turns away RUNS IN THE CLOUD instead. The control
# that actually stops work is the DB-backed global stop flag
# (POST /api/fleet/kill-switch/stop, platform admin).
FLEET_NODE_RUNTIME_ENABLED=true

# How long a one-time enrollment token stays redeemable, in ms.
# Default 900000 (15 minutes), floored at 30s so a token can always be typed.
# FLEET_ENROLLMENT_TOKEN_TTL_MS=900000

# Silence after which an 'online' node is swept to 'offline', in ms.
# Default 300000 (5 minutes), floor 30s. Setting this below a node's heartbeat
# cadence makes healthy nodes flap.
# FLEET_NODE_OFFLINE_AFTER_MS=300000

# Capability-tag bounds a node may advertise. Both are part of the wire
# contract: lowering them rejects heartbeats from nodes already advertising
# more, which is a fleet-wide 400.
# FLEET_MAX_CAPABILITY_TAGS=16              (default 16, hard ceiling 64)
# FLEET_MAX_CAPABILITY_TAG_LENGTH=32        (default 32, hard ceiling 128)

# Daily (UTC day) model-spend ceilings, in DOLLARS. Unset means no ceiling and
# zero behaviour change; enabling one is an explicit decision, and crossing it
# DRAINS the node until its owner re-enables it. Per-node rows and the owner's
# fleet_cost_policies row override these deployment defaults.
# FLEET_NODE_DAILY_COST_CEILING_USD=
# FLEET_DAILY_COST_CEILING_USD=

# NODE SIDE, not set here. `EVER_WORKS_NODE_API_URL` is the operator pin for
# the control plane and belongs in the node's own service environment, not in
# this file. It moves an enrolled machine to a stable API origin (stage, or a
# last-known-good prod) so a broken develop cannot orphan the fleet. See
# apps/node/README.md and docs/runbooks/FLEET_BREAK_GLASS.md.

# =============================================================================
# BUILD / RELEASE INFO (surfaced at GET /api/version and GET /api/health/ready)
# =============================================================================
# These are injected automatically at GitHub-build time by the
# docker-build-publish-* workflows (--build-arg -> Dockerfile ENV). You do not
# normally set them by hand; leave them empty locally and /api/version falls
# back to the package.json version + a `dev` commit.
#   BUILD_VERSION  - semver (defaults to the build's package.json version)
#   GIT_SHA        - full commit SHA the image was built from
#   GIT_REF        - branch or tag (e.g. develop, v1.2.3)
#   BUILD_RUN      - GitHub Actions run number
#   BUILD_TIME     - ISO-8601 build timestamp
# Optional override for the commit-link base (forks):
#   GITHUB_REPO_URL=https://github.com/ever-works/ever-works
BUILD_VERSION=
GIT_SHA=
GIT_REF=
BUILD_RUN=
BUILD_TIME=
