<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>{{title}} on {{appName}}</title>
        <style>
            body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f8fafc; line-height: 1.6; }
            .container { max-width: 600px; margin: 0 auto; }
            .logo-section { padding: 40px 20px 30px; text-align: center; }
            .logo-title { font-size: 28px; font-weight: 600; color: #1e293b; margin: 0; }
            .logo-subtitle { font-size: 14px; color: #94a3b8; margin: 5px 0 0; }
            .main-card { margin: 0 20px 40px; background-color: #ffffff; border-radius: 8px; padding: 40px 30px; }
            .title { font-size: 24px; color: #1e293b; font-weight: 600; text-align: center; margin: 0 0 16px; }
            .message { color: #475569; margin: 0 0 20px; font-size: 16px; white-space: pre-line; }
            .button-container { text-align: center; margin-top: 28px; }
            .button { display: inline-block; text-decoration: none; font-size: 16px; font-weight: 500; border-radius: 6px; background-color: #1e293b; color: #ffffff; padding: 12px 32px; }
            .reason { font-size: 13px; color: #64748b; text-align: center; margin: 28px 0 0; }
            .footer { padding: 20px; text-align: center; color: #94a3b8; font-size: 12px; }
            .footer a { color: #64748b; }
        </style>
    </head>
    <body>
        <div class='container'>
            <div class='logo-section'>
                <h1 class='logo-title'>{{appName}}</h1>
                <p class='logo-subtitle'>Notification</p>
            </div>
            <div class='main-card'>
                <h2 class='title'>{{title}}</h2>
                <p class='message'>{{message}}</p>

                {{#if actionUrl}}
                    <div class='button-container'>
                        <a href='{{actionUrl}}' class='button'>{{actionLabel}}</a>
                    </div>
                {{/if}}

                <p class='reason'>
                    You get this because
                    <strong>{{eventTitle}}</strong>
                    is on for Email.
                    <a href='{{settingsUrl}}'>Change what you hear about</a>
                </p>
            </div>
            <div class='footer'>
                &copy;
                {{currentYear}}
                {{companyOwner}}.
            </div>
        </div>
    </body>
</html>
