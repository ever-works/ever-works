{
	"name": "ever-works-node",
	"version": "0.1.0",
	"description": "Ever Works Node - headless execution node (CLI + long-running service): fleet enrollment, heartbeat and capability reporting",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"license": "AGPL-3.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		}
	},
	"bin": {
		"ever-works-node": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --noEmit && tsc -p tsconfig.build.json",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"start": "node dist/cli.js start",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"commander": "^14.0.2"
	},
	"devDependencies": {
		"@types/node": "^22.19.11",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	}
}
