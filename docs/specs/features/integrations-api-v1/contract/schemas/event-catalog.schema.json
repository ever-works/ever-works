{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ever.works/schemas/integrations/v1/event-catalog.schema.json",
	"title": "Shape of event-catalog.v1.json",
	"type": "object",
	"required": ["contract", "contractVersion", "catalogVersion", "events"],
	"properties": {
		"$schema": { "type": "string" },
		"contract": { "const": "ever-works-integrations" },
		"contractVersion": { "type": "string" },
		"catalogVersion": { "type": "integer", "minimum": 1 },
		"description": { "type": "string" },
		"events": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["type", "version", "domain", "aggregateType", "dataSchema", "phase"],
				"properties": {
					"type": { "type": "string", "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*){1,3}$" },
					"version": { "type": "integer", "minimum": 1 },
					"domain": { "type": "string" },
					"aggregateType": { "type": "string" },
					"dataSchema": {
						"description": "Path relative to the catalog file, optionally with a #/$defs/... fragment. null = reserved type (data schema published with its phase).",
						"type": ["string", "null"]
					},
					"fullDataSchema": {
						"description": "For *.visibility_changed between team and organization: the full DTO schema the data also satisfies.",
						"type": "string"
					},
					"phase": { "type": "string", "enum": ["P1", "P2", "P3", "P4", "P5"] },
					"child": { "type": "string" },
					"optIn": { "type": "boolean" },
					"notes": { "type": "string" }
				},
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false
}
